{
  "manifest_version": 3,
  "name": "Harbor Terminal",
  "version": "1.2.1",
  "description": "Install and open a password-protected PHP command console on your own cPanel hosting account.",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "scripting",
    "contextMenus",
    "activeTab"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_title": "Harbor Terminal",
    "default_popup": "extension/popup.html"
  },
  "background": {
    "service_worker": "extension/background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "extension/options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
